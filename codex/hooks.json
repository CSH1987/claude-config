{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/session-context.sh\"",
            "timeout": 10,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/session-end.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
