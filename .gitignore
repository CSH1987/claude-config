# OMC (oh-my-claudecode) runtime state — never commit
.omc/

# Claude settings backups created by install scripts
claude/settings.json.bak.*

# model-watch's atomic-write temp files (crash between write and os.replace should
# never leave one committed by config-sync's `git add -A`)
*.tmp-model-watch

# Python bytecode cache (created when metrics.py / hooks run python3 locally) — never commit
__pycache__/
*.pyc
